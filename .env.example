# Environment Variables for Travel Companion App
# Copy this file to .env and fill in your actual API keys
# NEVER commit the .env file to version control!

# Google Maps Platform API Key
# Get it from: https://console.cloud.google.com/
# Enable: Maps SDK for Android, Maps SDK for iOS, Places API, Geocoding API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenAI API Key (for AI itinerary generation and chat)
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenWeather API Key (for weather forecasts)
# Get it from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Currency Exchange API Key (optional)
# Get it from: https://www.exchangerate-api.com/
CURRENCY_API_KEY=your_currency_api_key_here

# Firebase Configuration (optional, for cloud sync and auth)
# Configure through Firebase Console and download config files
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_API_KEY=your_firebase_api_key
