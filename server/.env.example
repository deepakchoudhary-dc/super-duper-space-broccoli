[TEMPLATE]
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=api_guardian
DB_USER=postgres
DB_PASSWORD=your_password
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT=2000

# JWT Configuration — SEPARATE SECRETS FOR ACCESS & REFRESH TOKENS
# Using different secrets prevents refresh tokens from being used as access tokens
JWT_ACCESS_SECRET=your-access-token-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production-min-32-chars
JWT_SECRET=your-fallback-secret-if-above-not-set
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Email Configuration (for password reset, notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@api-guardian.com
FROM_NAME=API Guardian

# Email Verification
# Set to 'true' to skip email verification during development
SKIP_EMAIL_VERIFICATION=true

# API Guardian Configuration
API_GUARDIAN_DOMAIN=http://localhost:5000
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Rate Limiting
DEFAULT_RATE_LIMIT=1000
RATE_LIMIT_WINDOW=3600
# Optional multi-tier quotas (0 = disabled). These apply on top of the
# per-key rate_limit, evaluated from most restrictive to least:
BURST_RATE_LIMIT=0          # requests per second
HOURLY_RATE_LIMIT=0         # requests per hour
DAILY_RATE_LIMIT=0          # requests per day

# Gateway / Proxy
PROXY_CONNECT_TIMEOUT=30000
PROXY_MAX_SOCKETS=50
# Upstream resilience
UPSTREAM_HEALTH_CHECK_INTERVAL=30000
UPSTREAM_HEALTH_CHECK_TIMEOUT=3000
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN=30000
# SSRF protection (keep enabled in production)
SSRF_PROTECTION=true
# Comma-separated hostnames allowed to resolve to private ranges (dev only)
SSRF_ALLOW_PRIVATE=

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900000
# WAF: attack-pattern filtering (SQLi/XSS/path traversal/command injection)
WAF_ENABLED=true

# 2FA Configuration
TWO_FA_ISSUER=API Guardian
TWO_FA_WINDOW=1

# Observability
METRICS_ENABLED=true
METRICS_PATH=/metrics
TRACE_ENABLED=true

# Alerting
# Cooldown between rate-limit-exceeded alert emails (ms)
RATE_LIMIT_ALERT_COOLDOWN=900000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log
